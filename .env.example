# Copy to .env.local. Never commit real values. Nothing secret may use the NEXT_PUBLIC_ prefix.

# Public non-secret configuration (cosmetic only; the server decides what is allowed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Key-ching
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEMO_MODE=true

# Server-only payments: "demo" (labelled simulation, no real money) or "flash" (Flash test GraphQL)
PAYMENTS_PROVIDER=demo
FLASH_GRAPHQL_URL=https://api.test.flashapp.me/graphql
# Leave as-is until Flash confirms the subscription URL/protocol; the server falls back to polling + reconciliation.
FLASH_WS_URL=CONFIRM_WITH_FLASH_DOCS
FLASH_API_KEY=SET_LOCALLY_ONLY
FLASH_BTC_WALLET_ID=SET_LOCALLY
FLASH_USD_WALLET_ID=SET_LOCALLY
FLASH_NETWORK=CONFIRM_WITH_MENTOR
# Max payout fee per transfer, in the cycle's settlement units (sats or USD cents)
PAYMENT_MAX_FEE_UNITS=10
# Hard cap on any single invoice or payout, in settlement units
PAYMENT_MAX_PRINCIPAL_UNITS=20000

# Server persistence/session/worker
# SQLite file path. Needs a persistent disk: never deploy on ephemeral serverless storage.
DATABASE_URL=file:./data/chama.db
SESSION_SECRET=GENERATE_RANDOM_SECRET_LOCALLY
INTERNAL_WORKER_SECRET=GENERATE_RANDOM_SECRET_LOCALLY
RECEIPT_SIGNING_SECRET=GENERATE_RANDOM_SECRET_LOCALLY
# Flash test deployments only: shared sign-in passcode for the invited test group (OTP is roadmap).
AUTH_PASSCODE=SET_FOR_FLASH_TEST_DEPLOYMENT

# FX: "demo" uses the labelled Figma fixture rates (0.644 sats/KES etc.)
FX_PROVIDER=demo
RECONCILE_INTERVAL_SECONDS=30
# Only honoured with PAYMENTS_PROVIDER=demo. Enables the "Simulate test-wallet payment" button.
ALLOW_SIMULATED_PAYMENTS=true
