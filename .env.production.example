# Production pilot settings (Flash USD-stable, live KES/USD rate). Copy values into .env.local / your host's secret store.
# Never commit real values. Generate secrets with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN
NEXT_PUBLIC_APP_NAME=Chama on Lightning
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEMO_MODE=false

PAYMENTS_PROVIDER=flash
ALLOW_SIMULATED_PAYMENTS=false
FX_PROVIDER=live

FLASH_GRAPHQL_URL=https://api.flashapp.me/graphql
FLASH_ALLOW_PRODUCTION=true
FLASH_API_KEY=PASTE_KEY_HERE
FLASH_USD_WALLET_ID=9dbdc9b5-bed5-47ae-8808-fa3e3fa2ebcf
# Leave empty: this account has no BTC wallet, so Bitcoin chamas are disabled.
FLASH_BTC_WALLET_ID=
FLASH_WS_URL=
FLASH_NETWORK=Flash production

# Limits in USD cents. 5000 = $50 per invoice/payout; raise only deliberately.
PAYMENT_MAX_PRINCIPAL_UNITS=5000
PAYMENT_MAX_FEE_UNITS=50

DATABASE_URL=file:/data/chama.db
SESSION_SECRET=GENERATE_24_PLUS_CHARS
INTERNAL_WORKER_SECRET=GENERATE_24_PLUS_CHARS
RECEIPT_SIGNING_SECRET=GENERATE_24_PLUS_CHARS
# Pilot access passcode (12+ chars). Required to request a sign-in code, so strangers cannot spend your SMS budget.
AUTH_PASSCODE=CHOOSE_12_PLUS_CHARS
# Phone sign-in codes by SMS. "console" only prints codes to the server log (development).
SMS_PROVIDER=africastalking
AT_USERNAME=PASTE_AFRICASTALKING_USERNAME
AT_API_KEY=PASTE_AFRICASTALKING_API_KEY
AT_SENDER_ID=
RECONCILE_INTERVAL_SECONDS=30
